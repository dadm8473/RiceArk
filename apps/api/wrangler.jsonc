{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riceark-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "riceark",
      "database_id": "c93687c6-a34f-474a-a096-08b78c4fadd3"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "edf3d42b486a46bb8a18da43359a118e"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "COOKIE_DOMAIN": "127.0.0.1",
    "ENVIRONMENT": "local"
  }
}
