{
  "name": "@riceark/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply riceark --local",
    "test:d1-sql": "node scripts/verify-board-bulk-sql.mjs && node scripts/verify-admin-user-query.mjs",
    "test:d1-admin-users": "node scripts/verify-admin-user-query.mjs",
    "measure:board-reads": "node scripts/measure-board-read-path.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "@riceark/core": "workspace:*",
    "hono": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "wrangler": "^4.18.0"
  }
}
