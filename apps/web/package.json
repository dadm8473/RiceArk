{
  "name": "@riceark/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:functions": "wrangler pages functions build functions --outdir ../../.wrangler/pages-functions-build",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "vite --host 127.0.0.1",
    "deploy": "wrangler pages deploy dist --project-name riceark",
    "preview:pages": "vite build && wrangler pages functions build functions --outdir ../../.wrangler/pages-functions-build && wrangler pages dev dist --compatibility-date=2026-05-29 --compatibility-flag=nodejs_compat"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@riceark/api": "workspace:*",
    "@riceark/core": "workspace:*",
    "@vitejs/plugin-react": "^4.5.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "wrangler": "^4.18.0"
  }
}
